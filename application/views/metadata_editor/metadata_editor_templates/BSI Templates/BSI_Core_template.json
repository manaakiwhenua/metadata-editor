                "title": "Required metadata fields",
                "help_text": "List of required metadata fields for this MWLR Core Metadata Schema.",
                "expanded": true,
                "items": [
                    {
                        "title": "Required metadata",
                        "key": "required_metadata1785202598940",
                        "type": "section",
                        "expanded": true,
                        "items": [
                            {
                                "key": "required_metadata.resourceType",
                                "title": "Resource Type",
                                "type": "string",
                                "rules": {
                                    "required": true
                                },
                                "required": true,
                                "help_text": "The nature or genre of the resource, from the DCMI Type Vocabulary. Limited subset used",
                                "display_type": "dropdown-custom",
                                "is_required": true,
                                "enum_store_column": "code",
                                "default": "Dataset",
                                "enum": [
                                    {
                                        "code": "Dataset",
                                        "label": "Dataset"
                                    }
                                ]
                            },
                            {
                                "key": "required_metadata.title",
                                "title": "Title",
                                "type": "string",
                                "required": true,
                                "help_text": "A title giving an overview of the dataset.",
                                "display_type": "text",
                                "is_required": true,
                                "rules": {
                                    "required": true
                                }
                            },
                            {
                                "key": "required_metadata.description",
                                "title": "Description",
                                "type": "string",
                                "required": true,
                                "help_text": "This is a brief narrative summary of the content of the dataset. The abstract should provide a clear and concise statement that enables the reader to understand the content of the data. Include the following: the main attributes, data sources, why it was created, what it can be used for if reused, any data quality issue. Do not use unexplained acronyms.",
                                "display_type": "textarea",
                                "content_format": "text",
                                "rules": {
                                    "required": true
                                },
                                "is_required": true
                            },
                            {
                                "key": "required_metadata.roles",
                                "title": "Roles",
                                "type": "array",
                                "required": true,
                                "rules": {
                                    "required": true
                                },
                                "is_required": true,
                                "help_text": "List people who have been involved with the creation and management of the dataset. It is important to state who the creator (Author) was. 'Author' is used for the person or organisation chiefly responsible for the intellectual content.",
                                "props": [
                                    {
                                        "key": "name",
                                        "title": "Name",
                                        "type": "string",
                                        "prop_key": "required_metadata.roles.name",
                                        "help_text": "Full name of the person or organisation.",
                                        "display_type": "text",
                                        "required": false
                                    },
                                    {
                                        "key": "orcid",
                                        "title": "ORCID",
                                        "type": "string",
                                        "prop_key": "required_metadata.roles.orcid",
                                        "required": false,
                                        "help_text": "ORCID identifier URI for the person (e.g. https:\/\/orcid.org\/0000-0000-0000-0000).",
                                        "display_type": "text",
                                        "rules": {
                                            "is_uri": true
                                        }
                                    },
                                    {
                                        "key": "role",
                                        "title": "Role",
                                        "type": "string",
                                        "prop_key": "required_metadata.roles.role",
                                        "required": true,
                                        "rules": {
                                            "required": true
                                        },
                                        "help_text": "The role in relation to the dataset.",
                                        "display_type": "dropdown-custom",
                                        "enum_store_column": "code",
                                        "enum": [
                                            {
                                                "code": "author",
                                                "label": "Author"
                                            },
                                            {
                                                "code": "custodian",
                                                "label": "Custodian"
                                            },
                                            {
                                                "code": "pointOfContact",
                                                "label": "Point Of Contact"
                                            },
                                            {
                                                "code": "dataCollector",
                                                "label": "Data Collector"
                                            },
                                            {
                                                "code": "contributor",
                                                "label": "Contributor"
                                            },
                                            {
                                                "code": "funder",
                                                "label": "Funder"
                                            }
                                        ]
                                    },
                                    {
                                        "key": "organisation",
                                        "title": "Organisation",
                                        "type": "string",
                                        "prop_key": "required_metadata.roles.organisation",
                                        "required": true,
                                        "help_text": "The organisation the role is affiliated with.",
                                        "display_type": "text",
                                        "rules": {
                                            "required": true
                                        },
                                        "default": "Bioeconomy Science Institute Maiangi Taiao"
                                    }
                                ]
                            },
                            {
                                "key": "required_metadata.dateCreated",
                                "title": "Date Created",
                                "type": "date",
                                "required": true,
                                "rules": {
                                    "required": true
                                },
                                "help_text": "Date the dataset was created, in ISO 8601 format (YYYY-MM-DD). Date of creation differs from the temporal coverage. For example, a dataset might have been created in February 2009 (2009-02-15) but the data was collected during the year 2008 (temporal coverage from 2008-01-01 to 2008-12-31)",
                                "display_type": "date",
                                "is_required": true
                            },
                            {
                                "key": "required_metadata.keywords",
                                "title": "Keywords",
                                "type": "simple_array",
                                "rules": {
                                    "required": true
                                },
                                "required": true,
                                "help_text": "Use the keywords feature to provide more specific terms that describe the dataset's content. These can be used to identify particular concepts, places, techniques, or any other relevant aspect that the dataset addresses. When possible, existing vocabularies should be used to source keywords. An example of global vocabulary is the Global Change Master Directory. Alternatively, GEMET, the GEneral Multilingual Environmental Thesaurus.",
                                "is_required": true,
                                "display_type": "dropdown-custom"
                            },
                            {
                                "key": "required_metadata.publisher",
                                "title": "Publisher",
                                "type": "string",
                                "rules": {
                                    "required": true
                                },
                                "required": true,
                                "is_required": true,
                                "help_text": "The entity responsible for publishing the dataset. Defaults to Bioeconomy Science Institute Maiangi Taiao.",
                                "display_type": "text",
                                "default": "Bioeconomy Science Institute Maiangi Taiao"
                            }
                        ]
                    }
                ]
            },
            {
                "type": "section_container",
                "key": "optional_additional_metadata",
                "title": "Optional additional metadata",
                "help_text": "Additional metadata fields. These fields are not required but recommended for completeness.",
                "items": [
                    {
                        "title": "Optional additional metadata",
                        "type": "section",
                        "key": "optional_additional_metadata1785202603803",
                        "items": [
                            {
                                "key": "optional_additional_metadata.alternativeTitle",
                                "title": "Alternative Title",
                                "required": false,
                                "help_text": "Alternative titles for the dataset. Use this field for te reo Māori titles or other variant names.",
                                "type": "simple_array",
                                "display_type": "dropdown-custom"
                            },
                            {
                                "key": "optional_additional_metadata.language",
                                "title": "Language",
                                "type": "simple_array",
                                "display_type": "dropdown-custom",
                                "required": false,
                                "help_text": "Specify the language(s) used in the dataset or its documentation (e.g. English, Te Reo Māori)."
                            },
                            {
                                "key": "optional_additional_metadata.resourceIdentifier",
                                "title": "Resource Identifier",
                                "type": "string",
                                "help_text": "A unique identifier for the dataset, preferably a DOI or other persistent URI.",
                                "display_type": "text"
                            },
                            {
                                "key": "optional_additional_metadata.datasetVersion",
                                "title": "Dataset Version",
                                "type": "string",
                                "required": false,
                                "help_text": "Specify the dataset version if applicable. Examples include 1.0 (first release), 1.1 (minor update), 2.0 (major revision), or 2026-07 (date-based version).",
                                "display_type": "text"
                            },
                            {
                                "key": "optional_additional_metadata.dateModified",
                                "title": "Date Modified",
                                "type": "nested_array",
                                "required": false,
                                "help_text": "The date the dataset was last modified or a new version released, in ISO 8601 format (YYYY-MM-DD). Repeat for each version.",
                                "props": [
                                    {
                                        "key": "date",
                                        "title": "Date",
                                        "type": "date",
                                        "prop_key": "optional_additional_metadata.dateModified.date",
                                        "help_text": "The date the dataset was modified or a new version released, in ISO 8601 format (YYYY-MM-DD).",
                                        "display_type": "date",
                                        "required": true,
                                        "rules": {
                                            "required": true
                                        },
                                        "is_required": true
                                    },
                                    {
                                        "key": "version",
                                        "title": "Version",
                                        "type": "string",
                                        "prop_key": "optional_additional_metadata.dateModified.version",
                                        "required": false,
                                        "help_text": "The version of the dataset corresponding to this modification date.",
                                        "display_type": "text"
                                    }
                                ]
                            },
                            {
                                "key": "optional_additional_metadata.audience",
                                "title": "Audience \/ Intended Users",
                                "type": "string",
                                "required": false,
                                "help_text": "The intended audience or expected users of the dataset.",
                                "display_type": "textarea",
                                "content_format": "text"
                            },
                            {
                                "key": "optional_additional_metadata.datePublished",
                                "title": "Date Published \/ Released",
                                "type": "date",
                                "required": false,
                                "help_text": "The date the dataset was first published or made publicly available, in ISO 8601 format (YYYY-MM-DD).",
                                "display_type": "date"
                            },
                            {
                                "key": "optional_additional_metadata.relatedResources",
                                "title": "Related Resources",
                                "type": "array",
                                "required": false,
                                "help_text": "Provide the named and links to publications, reports, protocols, software, websites, or other resources that help users understand or use this dataset. Persistent identifiers (URI) (e.g. DOI or URL) preferred. Use ADD ROW to add more items.\n\nThe 'Relation Type' field has the following options:\n\nDerived from: Source dataset used to create this dataset\nPart of: Part of a collection or larger dataset\nHas part: Dataset/component belonging to this dataset\nDocumented by: Methodology, protocol, README, technical report\nDescribed by: Data paper describing the dataset\nReferences: Relevant publication/resource\nCites: Formally cited research/resource\nVersion of: Version relationship\nNew version of: Previous dataset release\nRequires: Software, model or other dependency\nOther: Anything not represented above\n",
                                "props": [
                                    {
                                        "key": "resource",
                                        "title": "Description of Resource",
                                        "type": "string",
                                        "prop_key": "optional_additional_metadata.relatedResources.resource",
                                        "required": false,
                                        "help_text": "A description of the relationship to the related resource.",
                                        "display_type": "text"
                                    },
                                    {
                                        "key": "relationType",
                                        "title": "Relation Type",
                                        "type": "string",
                                        "prop_key": "optional_additional_metadata.relatedResources.relationType",
                                        "required": false,
                                        "help_text": "The nature of the relationship between the dataset and the related resource.",
                                        "display_type": "dropdown-custom",
                                        "enum_store_column": "code",
                                        "enum": [
                                            {
                                                "code": "isDerivedFrom",
                                                "label": "Derived from"
                                            },
                                            {
                                                "code": "isPartOf",
                                                "label": "Part of"
                                            },
                                            {
                                                "code": "hasPart",
                                                "label": "Has part"
                                            },
                                            {
                                                "code": "isDocumentedBy",
                                                "label": "Documented by"
                                            },
                                            {
                                                "code": "isDescribedBy",
                                                "label": "Described by"
                                            },
                                            {
                                                "code": "references",
                                                "label": "References"
                                            },
                                            {
                                                "code": "cites",
                                                "label": "Cites"
                                            },
                                            {
                                                "code": "isVersionOf",
                                                "label": "Version of"
                                            },
                                            {
                                                "code": "isNewVersionOf",
                                                "label": "New version of"
                                            },
                                            {
                                                "code": "requires",
                                                "label": "Requires"
                                            },
                                            {
                                                "code": "other",
                                                "label": "Other"
                                            }
                                        ]
                                    },
                                    {
                                        "key": "uri",
                                        "title": "URI",
                                        "type": "string",
                                        "prop_key": "optional_additional_metadata.relatedResources.uri",
                                        "required": false,
                                        "help_text": "A URI identifying the related resource (e.g. DOI, URL).",
                                        "display_type": "text",
                                        "rules": {
                                            "is_uri": true
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "section",
                                "key": "optional_additional_metadata.temporalCoverage",
                                "title": "Temporal Coverage",
                                "help_text": "The time span the dataset covers.",
                                "expanded": true,
                                "items": [
                                    {
                                        "key": "optional_additional_metadata.temporalCoverage.start",
                                        "title": "Start Date",
                                        "type": "date",
                                        "required": false,
                                        "help_text": "Start of the temporal coverage period, in ISO 8601 format (YYYY-MM-DD).",
                                        "display_type": "date"
                                    },
                                    {
                                        "key": "optional_additional_metadata.temporalCoverage.end",
                                        "title": "End Date",
                                        "type": "date",
                                        "required": false,
                                        "help_text": "End of the temporal coverage period, in ISO 8601 format (YYYY-MM-DD). Omit if ongoing.",
                                        "display_type": "date"
                                    },
                                    {
                                        "key": "optional_additional_metadata.temporalCoverage.description",
                                        "title": "Temporal Description",
                                        "type": "string",
                                        "required": false,
                                        "help_text": "Free-text description of the temporal coverage where precise dates are not available.",
                                        "display_type": "text"
                                    }
                                ]
                            },
                            {
                                "key": "optional_additional_metadata.geographicCoverage",
                                "title": "Geographic Coverage",
                                "type": "section",
                                "expanded": true,
                                "items": [
                                    {
                                        "key": "optional_additional_metadata.geographicCoverage.geographicElement",
                                        "title": "Geographic element",
                                        "type": "nested_array",
                                        "expanded": true,
                                        "props": [
                                            {
                                                "key": "geographicBoundingBox",
                                                "title": "Geographic Bounding Box",
                                                "type": "section",
                                                "display_type": "bounding_box",
                                                "bounding_box_options": {
                                                    "west": "geographicBoundingBox.westBoundLongitude",
                                                    "east": "geographicBoundingBox.eastBoundLongitude",
                                                    "south": "geographicBoundingBox.southBoundLatitude",
                                                    "north": "geographicBoundingBox.northBoundLatitude"
                                                },
                                                "props": [
                                                    {
                                                        "key": "geographicBoundingBox.westBoundLongitude",
                                                        "type": "number",
                                                        "title": "West bound longitude",
                                                        "display_type": "text",
                                                        "help_text": "Western-most coordinate of the limit of the dataset extent, expressed in longitude in decimal degrees."
                                                    },
                                                    {
                                                        "key": "geographicBoundingBox.eastBoundLongitude",
                                                        "type": "number",
                                                        "title": "East bound longitude",
                                                        "display_type": "text",
                                                        "help_text": "Eastern-most coordinate of the limit of the dataset extent, expressed in longitude in decimal degrees."
                                                    },
                                                    {
                                                        "key": "geographicBoundingBox.southBoundLatitude",
                                                        "type": "number",
                                                        "title": "South bound latitude",
                                                        "display_type": "text",
                                                        "help_text": "Southern-most coordinate of the limit of the dataset extent, expressed in latitude in decimal degrees."
                                                    },
                                                    {
                                                        "key": "geographicBoundingBox.northBoundLatitude",
                                                        "type": "number",
                                                        "title": "North bound latitude",
                                                        "display_type": "text",
                                                        "help_text": "Northern-most coordinate of the limit of the dataset extent, expressed in latitude in decimal degrees."
                                                    }
                                                ],
                                                "help_text": "This is the extent of the resource in the geographic space, given as a bounding box. Defining the coordinates of a rectangle representing the resource area on a map allows the discovery by geographical area. Click to draw a bounding box on the map or enter coordinates manually.\n\nProvide the coordinates bounding the limits of the dataset, by means of four properties:\n- West bound longitude: Western-most coordinate of the limit of the dataset extent, expressed in longitude in decimal degrees.\n- East bound longitude: Eastern-most coordinate of the limit of the dataset extent, expressed in longitude in decimal degrees.\n- South bound latitude: Southern-most coordinate of the limit of the dataset extent, expressed in latitude in decimal degrees.\n- North bound latitude: Northern-most coordinate of the limit of the dataset extent, expressed in latitude in decimal degrees.\n\nThe bounding box shall be as small as possible.\nThe bounding box shall be expressed in decimal degree with a precision of at least 2 decimals."
                                            },
                                            {
                                                "key": "geohash",
                                                "prop_key": "optional_additional_metadata.geographicCoverage.geographicElement.geohash",
                                                "title": "Geohash",
                                                "type": "array",
                                                "props": [
                                                    {
                                                        "key": "geohash",
                                                        "type": "string",
                                                        "title": "Geohash",
                                                        "rules": {
                                                            "required": true
                                                        },
                                                        "required": true,
                                                        "is_required": true,
                                                        "prop_key": "optional_additional_metadata.geographicCoverage.geographicElement.geohash.geohash",
                                                        "help_text": "The geohash is not explicitly defined in ISO 19139, but often used in profiles, extensions, or auxiliary metadata to support spatial search, indexing, or approximate location. For example, \"u4pruydqqvj\" represents a specific area near New York City. Geohashes can vary in length; more characters mean higher precision.",
                                                        "display_type": "textarea"
                                                    },
                                                    {
                                                        "key": "note",
                                                        "type": "string",
                                                        "title": "Note",
                                                        "prop_key": "optional_additional_metadata.geographicCoverage.geographicElement.geohash.note",
                                                        "help_text": "A descriptive or explanatory note about the Geohash value — e.g., resolution, use, limitations. For example, \"Geohash at 8-character precision (~19 meters accuracy).\"",
                                                        "display_type": "textarea"
                                                    }
                                                ],
                                                "help_text": "A short alphanumeric string representing a spatial location or bounding box using the Geohash encoding. The purpose is to provide a compact, human-readable, and indexable way to encode geographic areas."
                                            },
                                            {
                                                "key": "geographicDescription",
                                                "title": "Geographic description",
                                                "type": "string",
                                                "prop_key": "optional_additional_metadata.geographicCoverage.geographicElement.geographicDescription",
                                                "display_type": "textarea",
                                                "help_text": "A textual or coded description of the geographic area covered by the dataset or service. The purpose is to provide a named place or coded region (e.g., country, administrative unit) as a way to describe geographic extent, especially when precise coordinates or geometry are not available. This useful for indexing metadata by regions or matching data to known administrative areas."
                                            }
                                        ],
                                        "prop_key": "optional_additional_metadata.geographicCoverage.geographicElement",
                                        "help_text": "Spatial (horizontal) extent element. This can be defined either with a Bounding Box (recommended); or using Geographic Description - free text that defines the area covered. When the dataset covers one or more countries, it is recommended to enter the country names in this element, as it can then be used in data catalogs for filtering by geography.\n\nThe bounding box shall be as small as possible.\nThe bounding box shall be expressed in decimal degree with a precision of at least 2 decimals."
                                    }
                                ],
                                "help_text": ""
                            },
                            {
                                "key": "optional_additional_metadata.provenance",
                                "title": "Provenance \/ Project Context",
                                "type": "string",
                                "required": false,
                                "help_text": "Briefly describe how the dataset was created. Include the project name, data collection methods, processing, quality assurance, or other significant steps used to produce the dataset. Where relevant, include cultural provenance, such as whakapapa or other contextual information important for Māori data.",
                                "display_type": "textarea",
                                "content_format": "text"
                            },
                            {
                                "key": "optional_additional_metadata.comments",
                                "title": "Comments",
                                "type": "string",
                                "required": false,
                                "help_text": "Provide additional information that helps users understand or use the dataset but is not captured elsewhere.",
                                "display_type": "textarea",
                                "content_format": "text"
                            },
                            {
                                "key": "optional_additional_metadata.rightsHolder",
                                "title": "Rights Holder",
                                "type": "string",
                                "required": false,
                                "help_text": "Identify the person or organisation that owns or controls the rights to this dataset if not Bioeconomy Science Institute Maiangi Taiao.",
                                "display_type": "textarea",
                                "default": "Bioeconomy Science Institute Maiangi Taiao",
                                "content_format": "text"
                            },
                            {
                                "key": "optional_additional_metadata.accessRights",
                                "title": "Access Rights",
                                "type": "section",
                                "required": false,
                                "expanded": true,
                                "items": [
                                    {
                                        "key":"optional_additional_metadata.accessRights.accessRightsType",
                                        "title": "Access Rights",
                                        "type": "string",
                                        "display_type": "dropdown-custom",
                                        "help_text": "Specify who can access the dataset and any restrictions on access. Examples include Open, Restricted, Internal use only, Embargoed, or Access by agreement.",
                                        "enum_store_column": "code",
                                        "enum": [
                                            {
                                                "code": "open",
                                                "label": "Open"
                                            },
                                            {
                                                "code": "restricted",
                                                "label": "Restricted"
                                            },
                                            {
                                                "code": "embargoed",
                                                "label": "Embargoed"
                                            },
                                            {
                                                "code": "internal",
                                                "label": "Internal use only"
                                            },
                                            {
                                                "code": "accessByAgreement",
                                                "label": "Access by agreement"
                                            },
                                            {
                                                "code": "other",
                                                "label": "Other"
                                            }
                                        ]
                                    },
                                    {
                                        "key":"optional_additional_metadata.accessRights.accessRightsDescription",
                                        "title": "Access Rights Description",
                                        "type":"string",
                                        "display_type":"textarea",
                                        "help_text": "A description of the access rights. For sensitive or Māori-governed data, describe any governance or approval requirements that determine access."
                                    }
                                ]
                            },
                            {
                                "key": "optional_additional_metadata.licenseDetails",
                                "title": "License Details",
                                "type": "string",
                                "required": false,
                                "help_text": "Specify the license and agreement that governs use and reuse of the dataset. Include any data sharing agreements. Examples include CC BY 4.0 or a commercial or BSI-specific license. For Māori data, this may include iwi or hapū agreements, partnership agreements, or other Māori data governance arrangements that define how the data may be accessed and used.",
                                "display_type": "textarea",
                                "content_format": "text"
                            },
                            {
                                "key": "optional_additional_metadata.licenseURI",
                                "title": "License URI",
                                "type": "string",
                                "required": false,
                                "help_text": "Provide a URI to the license or agreement that governs use and reuse of the dataset. Persistent identifiers (URI) (e.g. DOI or URL) preferred.",
                                "display_type": "text",
                                "rules": {
                                    "is_uri": true
                                }
                            },
                            {
                                "key": "optional_additional_metadata.dataFormat",
                                "title": "Data Format",
                                "type": "simple_array",
                                "display_type": "dropdown-custom",
                                "required": false,
                                "help_text": "The file format(s) of the dataset. If files use different file types, use dominant type (e.g. CSV, FASTA, GeoTIFF, Shape, NetCDF, instrument-specific formats)."
                            },
                            {
                                "key": "optional_additional_metadata.dataLocation",
                                "title": "Location of Data",
                                "type": "array",
                                "required": false,
                                "help_text": "Specify where the dataset can be found. Record the storage location or access point that enables others to locate the data, such as a shared drive, SharePoint site, data repository, database, cloud storage, or a public location (e.g. repository, DOI, landing page or download URL). If the metadata will be publicly available, do not include internal file paths or system details.",
                                "props": [
                                    {
                                        "key": "location",
                                        "title": "Data Location",
                                        "type": "string",
                                        "prop_key": "optional_additional_metadata.dataLocation.location",
                                        "required": false,
                                        "help_text": "A description of the location where the data is stored.",
                                        "display_type": "text"
                                    },
                                    {
                                        "key": "uri",
                                        "title": "Location URI",
                                        "type": "string",
