                                        "type": "string",
                                        "prop_key": "required_metadata.agents.organisation",
                                        "required": true,
                                        "help_text": "The organisation the agent is affiliated with.",
                                        "display_type": "text",
                                        "default": "Bioeconomy Science Institute Maiangi Taiao"
                                    }
                                ]
                            },
                            {
                                "key": "required_metadata.dateCreated",
                                "title": "Date Created",
                                "type": "date",
                                "required": true,
                                "rules": {
                                    "required": true
                                },
                                "help_text": "Date the dataset was created, in ISO 8601 format (YYYY-MM-DD). Date of creation differs from the temporal coverage. For example, a dataset might have been created in February 2009 (2009-02-15) but the data was collected during the year 2008 (temporal coverage from 2008-01-01 to 2008-12-31)",
                                "display_type": "date",
                                "is_required": true
                            },
                            {
                                "key": "required_metadata.keywords",
                                "title": "Keywords",
                                "type": "simple_array",
                                "rules": {
                                    "required": true
                                },
                                "required": true,
                                "help_text": "Use the keywords feature to provide more specific terms that describe the dataset's content. These can be used to identify particular concepts, places, techniques, or any other relevant aspect that the dataset addresses. When possible, existing vocabularies should be used to source keywords. An example of global vocabulary is the Global Change Master Directory. Alternatively, GEMET, the GEneral Multilingual Environmental Thesaurus.",
                                "is_required": true,
                                "display_type": "dropdown-custom"
                            },
                            {
                                "key": "required_metadata.publisher",
                                "title": "Publisher",
                                "type": "string",
                                "rules": {
                                    "required": true
                                },
                                "required": true,
                                "is_required": true,
                                "help_text": "The entity responsible for publishing the dataset. Defaults to Bioeconomy Science Institute Maiangi Taiao.",
                                "display_type": "dropdown-custom",
                                "enum_store_column": "code",
                                "default": "Bioeconomy Science Institute Maiangi Taiao",
                                "enum": [
                                    {
                                        "code": "Bioeconomy Science Institute Maiangi Taiao",
                                        "label": "Bioeconomy Science Institute Maiangi Taiao"
                                    }
                                ]
                            }
                        ]
