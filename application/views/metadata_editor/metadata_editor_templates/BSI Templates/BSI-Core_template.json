                                        "title": "ORCID",
                                        "type": "string",
                                        "prop_key": "required_metadata.agents.orcid",
                                        "required": false,
                                        "help_text": "ORCID identifier URI for the person (e.g. https:\/\/orcid.org\/0000-0000-0000-0000).",
                                        "display_type": "text"
                                    },
                                    {
                                        "key": "role",
