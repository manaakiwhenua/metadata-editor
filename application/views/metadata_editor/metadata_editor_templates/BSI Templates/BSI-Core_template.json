                            },
                            {
                                "key": "required_metadata.description",
                                "title": "Description",
                                "type": "string",
                                "required": true,
                                "help_text": "This is a brief narrative summary of the content of the dataset. The abstract should provide a clear and concise statement that enables the reader to understand the content of the data. Include the following: the main attributes, data sources, why it was created, what it can be used for if reused, any data quality issue. Do not use unexplained acronyms.",
                                "display_type": "textarea",
                                "content_format": "text",
                                "rules": {
                                    "required": true
                                },
                                "is_required": true
                            },
                            {
                                "key": "required_metadata.agents",
                                "title": "Agents",
                                "type": "array",
                                "required": true,
                                "rules": {
                                    "required": true
                                },
                                "is_required": true,
                                "help_text": "List people who have been involved with the creation and management of the dataset. It is important to state who the creator (Author) was. 'Author' is used for the person or organisation chiefly responsible for the intellectual content.",
                                "props": [
                                    {
                                        "key": "name",
                                        "title": "Name",
                                        "type": "string",
                                        "prop_key": "required_metadata.agents.name",
                                        "help_text": "Full name of the person or organisation.",
                                        "display_type": "text",
                                        "required": false
                                    },
                                    {
