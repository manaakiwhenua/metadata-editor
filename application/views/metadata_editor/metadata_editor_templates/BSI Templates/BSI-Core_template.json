                            {
                                "key": "optional_additional_metadata.extent",
                                "title": "Geographic Coverage",
                                "type": "section",
                                "expanded": true,
                                "items": [
                                    {
                                        "key": "optional_additional_metadata.extent.geographicElement",
                                        "title": "Geographic element",
                                        "type": "nested_array",
                                        "expanded": true,
                                        "props": [
                                            {
                                                "key": "geographicBoundingBox",
                                                "title": "Geographic Bounding Box",
                                                "type": "section",
                                                "display_type": "bounding_box",
                                                "bounding_box_options": {
                                                    "west": "geographicBoundingBox.westBoundLongitude",
                                                    "east": "geographicBoundingBox.eastBoundLongitude",
                                                    "south": "geographicBoundingBox.southBoundLatitude",
                                                    "north": "geographicBoundingBox.northBoundLatitude"
                                                },
                                                "props": [
                                                    {
                                                        "key": "geographicBoundingBox.westBoundLongitude",
                                                        "type": "number",
                                                        "title": "West bound longitude",
                                                        "display_type": "text",
                                                        "help_text": "Western-most coordinate of the limit of the dataset extent, expressed in longitude in decimal degrees."
                                                    },
                                                    {
                                                        "key": "geographicBoundingBox.eastBoundLongitude",
                                                        "type": "number",
                                                        "title": "East bound longitude",
                                                        "display_type": "text",
                                                        "help_text": "Eastern-most coordinate of the limit of the dataset extent, expressed in longitude in decimal degrees."
                                                    },
                                                    {
                                                        "key": "geographicBoundingBox.southBoundLatitude",
                                                        "type": "number",
                                                        "title": "South bound latitude",
                                                        "display_type": "text",
                                                        "help_text": "Southern-most coordinate of the limit of the dataset extent, expressed in latitude in decimal degrees."
                                                    },
                                                    {
                                                        "key": "geographicBoundingBox.northBoundLatitude",
                                                        "type": "number",
                                                        "title": "North bound latitude",
                                                        "display_type": "text",
                                                        "help_text": "Northern-most coordinate of the limit of the dataset extent, expressed in latitude in decimal degrees."
                                                    }
                                                ],
                                                "help_text": "This is the extent of the resource in the geographic space, given as a bounding box. Defining the coordinates of a rectangle representing the resource area on a map allows the discovery by geographical area. Click to draw a bounding box on the map or enter coordinates manually.\n\nProvide the coordinates bounding the limits of the dataset, by means of four properties:\n- West bound longitude: Western-most coordinate of the limit of the dataset extent, expressed in longitude in decimal degrees.\n- East bound longitude: Eastern-most coordinate of the limit of the dataset extent, expressed in longitude in decimal degrees.\n- South bound latitude: Southern-most coordinate of the limit of the dataset extent, expressed in latitude in decimal degrees.\n- North bound latitude: Northern-most coordinate of the limit of the dataset extent, expressed in latitude in decimal degrees.\n\nThe bounding box shall be as small as possible.\nThe bounding box shall be expressed in decimal degree with a precision of at least 2 decimals."
                                            },
                                            {
                                                "key": "geohash",
                                                "prop_key": "optional_additional_metadata.extent.geographicElement.geohash",
                                                "title": "Geohash",
                                                "type": "array",
                                                "props": [
                                                    {
                                                        "key": "geohash",
                                                        "type": "string",
                                                        "title": "Geohash",
                                                        "prop_key": "optional_additional_metadata.extent.geographicElement.geohash.geohash",
                                                        "help_text": "The geohash is not explicitly defined in ISO 19139, but often used in profiles, extensions, or auxiliary metadata to support spatial search, indexing, or approximate location. For example, \"u4pruydqqvj\" represents a specific area near New York City. Geohashes can vary in length; more characters mean higher precision.",
                                                        "display_type": "textarea"
                                                    },
                                                    {
                                                        "key": "note",
                                                        "type": "string",
                                                        "title": "Note",
                                                        "prop_key": "optional_additional_metadata.extent.geographicElement.geohash.note",
                                                        "help_text": "A descriptive or explanatory note about the Geohash value — e.g., resolution, use, limitations. For example, \"Geohash at 8-character precision (~19 meters accuracy).\"",
                                                        "display_type": "textarea"
                                                    }
                                                ],
                                                "help_text": "A short alphanumeric string representing a spatial location or bounding box using the Geohash encoding. The purpose is to provide a compact, human-readable, and indexable way to encode geographic areas."
                                            },
                                            {
                                                "key": "geographicDescription",
                                                "title": "Geographic description",
                                                "type": "string",
                                                "prop_key": "optional_additional_metadata.extent.geographicElement.geographicDescription",
                                                "display_type": "textarea",
                                                "help_text": "A textual or coded description of the geographic area covered by the dataset or service. The purpose is to provide a named place or coded region (e.g., country, administrative unit) as a way to describe geographic extent, especially when precise coordinates or geometry are not available. This useful for indexing metadata by regions or matching data to known administrative areas."
                                            }
                                        ],
                                        "prop_key": "optional_additional_metadata.extent.geographicElement",
                                        "help_text": "Spatial (horizontal) extent element. This can be defined either with a Bounding Box (recommended); or using Geographic Description - free text that defines the area covered. When the dataset covers one or more countries, it is recommended to enter the country names in this element, as it can then be used in data catalogs for filtering by geography.\n\nThe bounding box shall be as small as possible.\nThe bounding box shall be expressed in decimal degree with a precision of at least 2 decimals."
                                    }                                    
                                ],
                                "help_text": ""
                            },
